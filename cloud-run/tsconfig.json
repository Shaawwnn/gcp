{
  "compilerOptions": {
    "target": "ES2020",
    // nodenext rather than commonjs: the latter implies moduleResolution
    // node10, which is deprecated in TS 5 and removed in 7. With no "type"
    // field in package.json this still emits CommonJS, as dist/ requires.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
