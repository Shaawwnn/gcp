{
  "compilerOptions": {
    "target": "ES2020",
    // nodenext replaces commonjs + moduleResolution "node" (node10), which is
    // deprecated in TS 5 and removed in 7.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2020"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["types/**/*", "constants/**/*"],
  "exclude": ["node_modules", "dist"]
}
